# Copy to .env before the first run:  cp .env.example .env

# --- model -------------------------------------------------------------------
# Apache 2.0, ungated -- no HF token required.
MODEL_ID=Qwen/Qwen-Image-Edit-2509
# Pin a commit to make a project reproducible; blank means "whatever main is".
MODEL_REVISION=
# Diffusers revision used at build time (SHA once one is verified).
DIFFUSERS_REF=main

# --- output ------------------------------------------------------------------
# Landscape, on LTX-2.5's multiple-of-64 grid. 1280x768 is ~0.98 MP, which is
# where Qwen-Image-Edit is strongest; do not go much above 1.6 MP on 24 GB cards.
WIDTH=1280
HEIGHT=768
JPEG_QUALITY=95

# --- sampling ----------------------------------------------------------------
STEPS=28
TRUE_CFG_SCALE=4.0
GUIDANCE_SCALE=1.0
# Base for the per-shot seed derivation (seed = sha256(base:shot:tag)).
SEED_BASE=42

# --- behaviour ---------------------------------------------------------------
# sequential: render start, then condition stop on it (locks lighting/background).
# independent: render both from the references alone (better when the camera moves).
PAIR_MODE=sequential
# auto | fp8-t2i-cpu | fp8-offload | bf16-offload.  auto reads RAM and VRAM.
PROFILE=auto
# 0 = decide from measured RAM. One worker per GPU only pays off above ~74 GB RAM.
WORKERS=0
# A style key (pixar, clay, cartoon, anime, noir, realistic) or free text.
STYLE=
MAX_PROMPT_WORDS=120
# Cap reference images on the long edge. Attention runs over the output latents plus
# every reference's latents, so a 1672x941 plate is ~6,200 tokens against an output of
# ~3,840. 768 keeps colours and silhouette at roughly a fifth of that cost. 0 = off.
REF_MAX_EDGE=768

# --- host mounts (compose only) ----------------------------------------------
MODELS_HOST_DIR=./models
REFERENCE_HOST_DIR=./reference
SHOTS_HOST_DIR=./shots
OUTPUT_HOST_DIR=./output
TAG=latest
