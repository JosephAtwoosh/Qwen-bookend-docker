# Qwen-bookend studio -- Apache rules for the app root.
#
# The app uses query-string routing, so there is deliberately no RewriteRule here:
# this file works unchanged on hosts where mod_rewrite is unavailable or disabled.
#
# Note: <Directory> is NOT allowed in .htaccess. Directory-level denials therefore
# live in data/.htaccess and src/.htaccess, which Apache does honour.

Options -Indexes

# Path-independent guard: databases and built archives are never web files.
<FilesMatch "\.(sqlite|sqlite3|db|gz)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Upload limits, only where PHP runs as an Apache module (not under PHP-FPM).
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
</IfModule>
